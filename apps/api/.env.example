NODE_ENV=development
PORT=3333
# Postgres do docker-compose (porta 5434 no host)
DATABASE_URL="postgresql://twitter:twitter@localhost:5434/twitter?schema=public"
# Origem do front (CORS)
WEB_ORIGIN=http://localhost:5173
# Segredo do JWT de acesso (mín. 32 caracteres). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Cloudinary (upload de avatar/banner). Painel: https://console.cloudinary.com → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Proxies na frente da API em produção (Railway/Render: 1). Em dev, 0.
TRUST_PROXY=0

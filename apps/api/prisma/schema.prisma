// Schema do banco. Os models entram fase a fase.
// Convenção: models/campos em camelCase no código, tabelas/colunas em snake_case no banco.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(50)
  // sempre minúsculo: garante unicidade sem diferenciar maiúsculas e URLs estáveis (/fulano)
  username     String   @unique @db.VarChar(15)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  bio          String?  @db.VarChar(160)
  location     String?  @db.VarChar(30)
  website      String?  @db.VarChar(100)
  avatarUrl    String?  @map("avatar_url")
  bannerUrl    String?  @map("banner_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  tweets        Tweet[]
  following     Follow[]       @relation("UserFollowing")
  followers     Follow[]       @relation("UserFollowers")
  likes         Like[]
  bookmarks     Bookmark[]
  mentions      Mention[]

  @@map("users")
}

// O id é UUID v7, que já nasce ordenado pelo tempo: ordenar por id = ordenar por data,
// e a paginação por cursor usa o próprio id (sem precisar de índice extra em created_at).
//
// Uma linha pode ser:
// - post normal
// - resposta (reply_to_id): se o post respondido for apagado, vira NULL, mas is_reply
//   continua true para mostrar "post indisponível"
// - citação (quote_of_id + is_quote), com a mesma lógica
// - repost (retweet_of_id): sem texto próprio, apagado junto com o original
model Tweet {
  id           String                   @id @default(uuid(7)) @db.Uuid
  authorId     String                   @map("author_id") @db.Uuid
  content      String                   @default("") @db.VarChar(280)
  replyToId    String?                  @map("reply_to_id") @db.Uuid
  isReply      Boolean                  @default(false) @map("is_reply")
  quoteOfId    String?                  @map("quote_of_id") @db.Uuid
  isQuote      Boolean                  @default(false) @map("is_quote")
  retweetOfId  String?                  @map("retweet_of_id") @db.Uuid
  editedAt     DateTime?                @map("edited_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  // Índice de busca (full-text em português, sem acentos). Preenchido por um trigger no
  // banco a cada INSERT/UPDATE do conteúdo; o Prisma só precisa saber que a coluna existe.
  searchVector Unsupported("tsvector")? @map("search_vector")

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media     TweetMedia[]
  likes     Like[]
  bookmarks Bookmark[]
  hashtags  TweetHashtag[]
  mentions  Mention[]

  replyTo   Tweet?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Tweet[] @relation("Replies")
  quoteOf   Tweet?  @relation("Quotes", fields: [quoteOfId], references: [id], onDelete: SetNull)
  quotes    Tweet[] @relation("Quotes")
  retweetOf Tweet?  @relation("Retweets", fields: [retweetOfId], references: [id], onDelete: Cascade)
  retweets  Tweet[] @relation("Retweets")

  // cada pessoa reposta um post no máximo uma vez (NULLs não colidem no Postgres)
  @@unique([authorId, retweetOfId])
  @@index([authorId, id(sort: Desc)])
  @@index([replyToId, id])
  @@index([quoteOfId])
  @@index([retweetOfId])
  @@index([searchVector], type: Gin, map: "tweets_search_vector_idx")
  @@map("tweets")
}

// Até 4 imagens por tweet. Largura/altura guardadas para o front reservar o espaço
// certo antes da imagem carregar (sem a página "pular").
model TweetMedia {
  id       String @id @default(uuid(7)) @db.Uuid
  tweetId  String @map("tweet_id") @db.Uuid
  url      String
  width    Int
  height   Int
  position Int    @db.SmallInt

  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@unique([tweetId, position])
  @@map("tweet_media")
}

// Refresh tokens opacos com rotação. Guardamos só o hash (SHA-256): se o banco vazar,
// os tokens não servem pra nada. Tokens da mesma "família" vêm do mesmo login;
// se um token já usado reaparecer, a família inteira é revogada (detecção de roubo).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// "follower segue following". Id próprio (UUID v7) para paginar as listas de seguidores
// por cursor, no mesmo padrão dos tweets; o par (follower, following) é único.
model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, id(sort: Desc)])
  @@index([followingId, id(sort: Desc)])
  @@map("follows")
}

model Like {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tweetId   String   @map("tweet_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
  @@index([tweetId])
  @@index([userId, id(sort: Desc)])
  @@map("likes")
}

// Itens salvos: mesmo formato das curtidas, mas privados (só o dono vê)
model Bookmark {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tweetId   String   @map("tweet_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
  @@index([tweetId])
  @@index([userId, id(sort: Desc)])
  @@map("bookmarks")
}

// Hashtags extraídas do texto do post (sem o #, em minúsculas).
// created_at copia a data do post: é por ela que os "Assuntos do momento" filtram as últimas 24h.
model TweetHashtag {
  tweetId   String   @map("tweet_id") @db.Uuid
  tag       String   @db.VarChar(100)
  createdAt DateTime @map("created_at")

  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@id([tweetId, tag])
  @@index([tag, tweetId(sort: Desc)])
  @@index([createdAt])
  @@map("tweet_hashtags")
}

// @menções a usuários que existem (base das notificações de menção na Fase 7)
model Mention {
  tweetId String @map("tweet_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tweetId, userId])
  @@index([userId])
  @@map("mentions")
}
